{"version":2,"width":110,"height":32,"timestamp":1794171192,"idle_time_limit":2.0,"command":"./demo.sh","title":"kmorph on Fedora bootc: crash takeover","env":{"SHELL":"/bin/bash"}}
[0.004423, "o", "\r\n\u001b[1;36m## kmorph on Fedora bootc: a crash takeover without rebooting the machine\u001b[0m\r\n"]
[0.004435, "o", "\r\n\u001b[1;36m## The bootc host is running the multikernel kernel, and has armed a successor kernel.\u001b[0m\r\n"]
[0.004439, "o", "\r\n\u001b[1;33m$ bootc status (on the bootc host)\u001b[0m\r\n"]
[0.174956, "o", "⠁ Waiting for sysroot lock...                                                                                 "]
[0.176135, "o", "\r\u001b[2K⠁ Waiting for sysroot lock...                                                                                 "]
[0.176413, "o", "\r\u001b[2K"]
[0.178035, "o", "● Booted image: localhost/fedora-bootc-kmorph:mk\r\n        Digest: sha256:84197266733a6edc613d261cdb68f98d50ffce9d8bc9ec6a222dfe5a9f59ecf8 (arm64)\r\n"]
[0.178131, "o", "       Version: 45.20261108.0 (2026-11-08T20:40:57Z)\r\n"]
[0.18045, "o", "\r\n\u001b[1;33m$ kmorph status\u001b[0m\r\n"]
[0.31553, "o", "successor: active (instance generation-1, id 1)\r\nkmorphd: ARMED predecessor=alive last_probe=64ms error=0\r\n"]
[0.316387, "o", "\r\n\u001b[1;33m$ successor instance state\u001b[0m\r\n"]
[0.446688, "o", "active\r\n"]
[2.448616, "o", "\r\n\u001b[1;36m## The successor is a separate kernel instance, alive beside the running one.\u001b[0m\r\n"]
[2.448631, "o", "\r\n\u001b[1;33m$ the successor is probing this kernel\u001b[0m\r\n"]
[2.580939, "o", "active\r\n"]
[2.58162, "o", "successor: active (instance generation-1, id 1)\r\nkmorphd: ARMED predecessor=alive last_probe=30ms error=0\r\n"]
[4.583557, "o", "\r\n\u001b[1;36m## Now kill the running kernel. The QEMU machine stays up; only the kernel dies.\u001b[0m\r\n"]
[4.583579, "o", "\r\n\u001b[1;33m$ echo c > /proc/sysrq-trigger\u001b[0m\r\n"]
[18.796949, "o", "Connection to 127.0.0.1 closed by remote host.\r\r\n"]
[19.798972, "o", "\r\n\u001b[1;36m## The successor notices the silence, fences the dead kernel, and adopts its devices, CPU and memory.\u001b[0m\r\n"]
[19.803448, "o", "[   16.970354] kmorphd: adopted 3 devices: 0 reset, 3 quiesced\r\r\n[   17.163274] kmorphd: adopted 1 CPUs and 14296 of 15346 MB (tx 6), 1028 MB at 0x3a4000000 kept for the next pool\r\r\n[   17.163392] kmorphd: state TAKEN_OVER\r\r\n"]
[21.80462, "o", "\r\n\u001b[1;36m## The same bootc deployment is running again, now on the successor kernel.\u001b[0m\r\n"]
[23.097244, "o", "\r\n\u001b[1;33m$ bootc status (on the successor)\u001b[0m\r\n"]
[23.259511, "o", "⠁ Waiting for sysroot lock...                                                                                 \r\u001b[2K⠁ Waiting for sysroot lock...                                                                                 "]
[23.260092, "o", "\r\u001b[2K"]
[23.262235, "o", "● Booted image: localhost/fedora-bootc-kmorph:mk\r\n        Digest: sha256:84197266733a6edc613d261cdb68f98d50ffce9d8bc9ec6a222dfe5a9f59ecf8 (arm64)\r\n"]
[23.26228, "o", "       Version: 45.20261108.0 (2026-11-08T20:40:57Z)\r\n"]
[23.264114, "o", "\r\n\u001b[1;33m$ uname -r\u001b[0m\r\n"]
[23.399273, "o", "7.0.0-mk4+\r\n"]
[23.399926, "o", "\r\n\u001b[1;33m$ takeover state\u001b[0m\r\n"]
[23.535695, "o", "TAKEN_OVER predecessor=silent last_probe=292ms error=0\r\n"]
[24.561198, "o", "\r\n\u001b[1;36m## The VM itself never rebooted: QEMU pid 332509 is still the same process.\u001b[0m\r\n"]
[24.563103, "o", " 332509       00:52 qemu-system-aar\r\n"]
[24.563415, "o", "\r\n\u001b[1;36m## The bootc deployment, /etc and /var are the same; only the kernel changed.\u001b[0m\r\n"]
[24.56363, "x", "0"]
